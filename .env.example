# Etsy Open API v3 key. Register an app at https://www.etsy.com/developers/register
# A provisional key works for personal use.
ETSY_API_KEY=

# Semrush Analytics API key (Business plan, uses API units). https://www.semrush.com/api-analytics/
SEMRUSH_API_KEY=
SEMRUSH_DB=us

# Set a password when deploying online so nobody else can use your API keys. Any username works.
APP_PASSWORD=

PORT=3456
