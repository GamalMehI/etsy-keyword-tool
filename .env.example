# Etsy Open API v3 Personal Access credentials. Both required; never commit .env.
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Optional Semrush Analytics API; no key is fine.
SEMRUSH_API_KEY=
SEMRUSH_DB=us

# Optional local HTTP Basic password. Any username works.
APP_PASSWORD=
PORT=3456

# Daily collection time in Africa/Casablanca. UI changes persist in SQLite.
COLLECT_HOUR=6
# Background work always protects at least 800 calls.
INTERACTIVE_RESERVE=800

# Use a separate mock database with 30 days of synthetic history.
ETSY_MOCK=0
